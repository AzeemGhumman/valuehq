# Copy to .env.local for `npm run dev`. Deployed stacks set these in template.yaml.
APP_ENV=local
AWS_REGION=us-east-1
TABLE_NAME=valuehq-local
DYNAMODB_ENDPOINT=http://localhost:8000
# Leave empty locally: jobs then run inside the dev server instead of Step Functions.
STATE_MACHINE_ARN=
# Where locally-run workers store crawls (workers README uses ../.data from workers/ = .data here). Lets the crawl explorer read them.
DATA_DIR=.data
